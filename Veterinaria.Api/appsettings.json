{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "VeterinariaDb": "<definir en appsettings.Development.json o user-secrets>"
  },
  "Jwt": {
    "Key": "<definir en appsettings.Development.json o user-secrets (minimo 32 caracteres)>",
    "Issuer": "VeterinariaApi",
    "Audience": "VeterinariaClientes",
    "ExpireMinutes": "60"
  }
}